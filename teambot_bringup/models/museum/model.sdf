<?xml version="1.0"?>
<sdf version="1.9">
  <model name="museum">
    <static>true</static>

    <link name="building">

      <visual name="museum_visual">
        <geometry>
          <mesh>
            <uri>model://museum/meshes/museum.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="museum_collision">
        <geometry>
          <mesh>
            <uri>model://museum/meshes/museum.dae</uri>
          </mesh>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
